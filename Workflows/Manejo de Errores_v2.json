        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH p AS (SELECT $1::jsonb AS j)\nINSERT INTO errores_workflow (workflow, workflow_id, nodo, mensaje, ejecucion_id, url)\nSELECT j->>'workflow', j->>'workflow_id', j->>'nodo', j->>'mensaje', j->>'ejecucion_id', j->>'url' FROM p\nRETURNING id",
        "options": {
          "queryReplacement": "={{ JSON.stringify({ workflow: $json.workflow?.name, workflow_id: $json.workflow?.id, nodo: $json.execution?.lastNodeExecuted, mensaje: $json.execution?.error?.message, ejecucion_id: $json.execution?.id, url: $json.execution?.url }) }}"
        }
      },
      "id": "d335a7f7-b3d5-56f3-a89b-aabfd42b2f89",
      "name": "Guardar Error",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        480,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000,
      "credentials": {
        "postgres": {
          "id": "UlGtn3m9UVQSeZw2",
          "name": "Postgres account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "sendTo": "={{ $('Configuración').first().json.admin_correo }}",
        "subject": "={{ '⚠️ Error en ' + $('Configuración').first().json.workflow?.name }}",
        "message": "={{ '<p><b>Workflow:</b> ' + $('Configuración').first().json.workflow?.name + '</p><p><b>Nodo:</b> ' + $('Configuración').first().json.execution?.lastNodeExecuted + '</p><p><b>Error:</b> ' + ($('Configuración').first().json.execution?.error?.message ?? '').replace(/</g, '&lt;') + '</p><p><a href=\"' + $('Configuración').first().json.execution?.url + '\">Ver ejecución</a></p>' }}",
        "options": {
          "appendAttribution": false
        }
