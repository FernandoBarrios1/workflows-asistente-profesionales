    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH p AS (SELECT $1::jsonb AS j)\nINSERT INTO recordatorios_enviados (event_id, cedula)\nSELECT j->>'clave', j->>'cedula' FROM p\nON CONFLICT (event_id) DO NOTHING",
