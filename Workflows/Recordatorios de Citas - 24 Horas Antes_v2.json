      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.correo }}",
        "subject": "⏰ Recordatorio: tu cita en MYF Consultoría",
        "message": "=<html><body style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:20px;background:#f5f5f5;\"><div style=\"background-color:#1a73e8;padding:24px 30px;border-radius:8px 8px 0 0;\"><h1 style=\"color:white;margin:0;font-size:22px;\">MYF Consultoría</h1></div><div style=\"background-color:#ffffff;padding:30px;border-radius:0 0 8px 8px;border:1px solid #e0e0e0;\"><h2 style=\"color:#1a73e8;margin-top:0;\">⏰ Recordatorio de cita</h2><p style=\"color:#444;font-size:16px;\">Hola <strong>{{ $json.nombre }} {{ $json.apellido }}</strong>,</p><p style=\"color:#444;font-size:16px;\">Te recordamos que tenés una cita programada con <strong>MYF Consultoría</strong>.</p><div style=\"background-color:#e8f0fe;border-left:4px solid #1a73e8;padding:16px 20px;margin:24px 0;border-radius:4px;\"><p style=\"margin:0 0 8px 0;color:#1a1a1a;font-size:16px;\">📅 <strong>{{ $json.fecha }} a las {{ $json.hora_inicio }} hs</strong></p><p style=\"margin:0;color:#333;font-size:14px;\">📂 {{ $json.area }} — {{ $json.descripcion }}</p></div><p style=\"color:#555;font-size:14px;\">Si necesitás reagendar o cancelar tu cita, podés hacerlo a través de nuestro asistente virtual:</p><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:20px auto;width:100%;\"><tr>\n<td align=\"center\" style=\"padding:8px;\"><a href=\"https://myftesis.netlify.app/\" target=\"_blank\" style=\"display:inline-block;background-color:#1a73e8;color:#ffffff;text-decoration:none;font-size:14px;font-weight:bold;padding:12px 20px;border-radius:6px;width:160px;text-align:center;\">🌐 Asistente Web</a></td>\n<td align=\"center\" style=\"padding:8px;\"><a href=\"https://t.me/MyFTesis_bot\" target=\"_blank\" style=\"display:inline-block;background-color:#229ED9;color:#ffffff;text-decoration:none;font-size:14px;font-weight:bold;padding:12px 20px;border-radius:6px;width:160px;text-align:center;\">✈️ Telegram</a></td>\n</tr></table><hr style=\"border:none;border-top:1px solid #e0e0e0;margin:24px 0;\"><p style=\"color:#999;font-size:12px;margin:0;\">Mensaje automático de MYF Consultoría. Por favor no responder.</p></div></body></html>",
        "options": {
          "appendAttribution": false
        }
      },
