{
  "name": "Recordatorios de Citas - 24 Horas Antes_v2",
  "nodes": [
    {
      "parameters": {
        "content": "## Recordatorios_v2\nUna sola consulta trae las citas que empiezan en las próximas 24 h que tienen correo y todavía no recibieron recordatorio (antes: 3 consultas por cita). Solo se marca como enviado si Gmail respondió OK; si falla se reintenta en la próxima corrida. Misma clave que la v1 (cedula_fecha_hora), así no se duplican recordatorios.",
        "height": 280,
        "width": 560,
        "color": 7
      },
      "id": "8e7262a5-b99f-5356-9c58-f5e402b7d7b6",
      "name": "Nota",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -240,
        -400
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/10 * * * *"
            }
          ]
        }
      },
      "id": "a57c2317-f85f-533e-a77e-9c57f84aa169",
      "name": "Cada 10 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT a.id, a.cedula, to_char(a.fecha, 'DD/MM/YYYY') AS fecha, a.hora_inicio, a.area,\n       replace(replace(replace(COALESCE(a.descripcion, ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;') AS descripcion,\n       a.cedula || '_' || to_char(a.fecha, 'YYYY-MM-DD') || '_' || a.hora_inicio AS clave,\n       cl.nombre, cl.apellido, cl.correo\nFROM agendamientos a\nJOIN LATERAL (\n  SELECT nombre, apellido, correo FROM clientes c\n  WHERE c.cedula = a.cedula AND COALESCE(c.correo, '') <> ''\n  ORDER BY id_cliente LIMIT 1\n) cl ON true\nWHERE a.asistencia = 'P'\n  AND (a.fecha + a.hora_inicio::time) >  (now() AT TIME ZONE 'America/Asuncion')\n  AND (a.fecha + a.hora_inicio::time) <= (now() AT TIME ZONE 'America/Asuncion') + interval '24 hours'\n  AND NOT EXISTS (\n    SELECT 1 FROM recordatorios_enviados r\n    WHERE r.event_id = a.cedula || '_' || to_char(a.fecha, 'YYYY-MM-DD') || '_' || a.hora_inicio\n  )\nORDER BY a.fecha, a.hora_inicio",
        "options": {}
      },
      "id": "746475a2-a8eb-5a77-ba05-7471dfacbd12",
      "name": "Citas Sin Recordatorio",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000,
      "credentials": {
        "postgres": {
          "id": "UlGtn3m9UVQSeZw2",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "26b84c73-7f16-546c-9fd4-9e464b2f7d48",
              "leftValue": "={{ !!$json.clave }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1f80f28d-dad1-57a2-845e-6bb2445c993b",
      "name": "¿Hay citas pendientes?",
      "type": "n8n-nodes-base.if",
